{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.yaseenmuhammed.com"
        }
      ],
      "destination": "https://yaseenmuhammed.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Muhammed_Yaseen_Resume.pdf",
      "destination": "/Muhammed_Yaseen_PV_CV.pdf",
      "permanent": true
    },
    {
      "source": "/inner-page.html",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/portfolio-details.html",
      "destination": "/#projects",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/Muhammed_Yaseen_PV_CV.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "trailingSlash": true
}
